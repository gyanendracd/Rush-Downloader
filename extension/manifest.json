{
  "manifest_version": 3,
  "name": "RushDownload (development)",
  "version": "0.1.0",
  "description": "Sends the downloads your browser starts, and the videos on a page, to the RushDownload app on this computer.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "webRequest", "storage", "contextMenus", "downloads", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RushDownload",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
